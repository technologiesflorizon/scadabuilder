<Window x:Class="QuickWindowIsolationPrototype.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QuickWindow Isolation Prototype — WebView2 Harness" Height="900" Width="1280" WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8" Foreground="#333" FontFamily="Consolas" Text="Initializing WebView2..." />
    </Grid>
</Window>
