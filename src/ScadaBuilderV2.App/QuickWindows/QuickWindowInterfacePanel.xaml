<UserControl x:Class="ScadaBuilderV2.App.QuickWindows.QuickWindowInterfacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelMutedBrush" Color="#5B7076"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE8DD"/>
        <SolidColorBrush x:Key="PanelDangerBrush" Color="#B3261E"/>
        <SolidColorBrush x:Key="PanelInkBrush" Color="#0F2A30"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
        <CollectionViewSource x:Key="GroupedMembers" Source="{Binding Members}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupLabel"/>
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="GroupOrder" Direction="Ascending"/>
                <scm:SortDescription PropertyName="Name" Direction="Ascending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Interface locale" FontWeight="SemiBold" Foreground="{StaticResource PanelInkBrush}"/>
            <TextBlock x:Name="DefinitionLabelText"
                       Text="{Binding DefinitionLabel}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PanelMutedBrush}"/>
            <TextBlock x:Name="SummaryText"
                       Text="{Binding SummaryLabel}"
                       FontSize="11"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource PanelMutedBrush}"/>
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBox x:Name="MemberSearchTextBox"
                     MinHeight="30"
                     Width="160"
                     Margin="0,0,8,6"
                     ToolTip="Recherche membre"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <ComboBox x:Name="MemberFamilyFilterComboBox"
                      MinHeight="30"
                      Width="160"
                      Margin="0,0,8,6"
                      ToolTip="Filtrer par famille"
                      DisplayMemberPath="Label"
                      ItemsSource="{Binding FamilyFilters}"
                      SelectedItem="{Binding SelectedFamilyFilter}"/>
            <Button x:Name="AddMemberButton"
                    MinHeight="30"
                    Padding="10,2"
                    Margin="0,0,8,6"
                    Content="+ Membre"
                    ToolTip="Ajouter un membre"
                    Click="OnAddMemberClick"/>
            <Button x:Name="EditMemberButton"
                    MinHeight="30"
                    Padding="10,2"
                    Margin="0,0,8,6"
                    Content="Propriétés avancées"
                    ToolTip="Contraintes et propriétés avancées du membre"
                    IsEnabled="{Binding HasSelection}"
                    Click="OnEditMemberClick"/>
            <Button x:Name="DeleteMemberButton"
                    MinHeight="30"
                    Padding="10,2"
                    Margin="0,0,0,6"
                    Content="Supprimer"
                    ToolTip="Supprimer le membre"
                    IsEnabled="{Binding HasSelection}"
                    Click="OnDeleteMemberClick"/>
        </WrapPanel>

        <DataGrid x:Name="InterfaceMembersDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  ItemsSource="{Binding Source={StaticResource GroupedMembers}}"
                  SelectedItem="{Binding Selected}"
                  MouseDoubleClick="OnMembersDoubleClick">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       Margin="2,6,0,2"
                                       Foreground="{StaticResource PanelInkBrush}"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="1.4*"/>
                <DataGridComboBoxColumn x:Name="FamilyColumn"
                                        Header="Famille"
                                        DisplayMemberPath="Label"
                                        SelectedValuePath="Value"
                                        SelectedValueBinding="{Binding Family}"
                                        Width="1.2*"/>
                <DataGridComboBoxColumn x:Name="DataTypeColumn"
                                        Header="Type"
                                        DisplayMemberPath="Label"
                                        SelectedValuePath="Value"
                                        SelectedValueBinding="{Binding DataType}"
                                        Width="1*"/>
                <DataGridComboBoxColumn x:Name="AccessColumn"
                                        Header="Accès"
                                        DisplayMemberPath="Label"
                                        SelectedValuePath="Value"
                                        SelectedValueBinding="{Binding Access}"
                                        Width="1*"/>
                <DataGridCheckBoxColumn Header="Requis" Binding="{Binding Required, UpdateSourceTrigger=PropertyChanged}" Width="0.6*"/>
                <DataGridTemplateColumn Header="Statut" Width="0.9*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BindingStatusLabel}" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource PanelInkBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUnboundOptional}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PanelMutedBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUnboundRequired}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource PanelDangerBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Utilisations" Width="1.1*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UsageLabel}"
                                           VerticalAlignment="Center"
                                           Margin="4,0,6,0"
                                           Foreground="{StaticResource PanelMutedBrush}"/>
                                <Button Content="Voir"
                                        Padding="6,1"
                                        MinHeight="22"
                                        ToolTip="Naviguer vers les utilisations de ce membre"
                                        Visibility="{Binding HasUsages, Converter={StaticResource BooleanToVisibility}}"
                                        Click="OnNavigateToUsageClick"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
