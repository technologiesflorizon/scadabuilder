<UserControl x:Class="ScadaBuilderV2.App.QuickWindows.QuickWindowInterfacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelMutedBrush" Color="#5B7076"/>
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#DCE8DD"/>
        <SolidColorBrush x:Key="PanelDangerBrush" Color="#B3261E"/>
        <SolidColorBrush x:Key="PanelInkBrush" Color="#0F2A30"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
    </UserControl.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Interface locale" FontWeight="SemiBold" Foreground="{StaticResource PanelInkBrush}"/>
            <TextBlock x:Name="PageLabelText"
                       Text="{Binding PageLabel}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PanelMutedBrush}"/>
            <TextBlock Text="Liste en lecture seule des #N utilisés par la page active et leurs emplacements."
                       FontSize="11"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PanelMutedBrush}"/>
        </StackPanel>

        <ItemsControl DockPanel.Dock="Top"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding InvalidPlaceholderTokens}"
                      Visibility="{Binding HasInvalidPlaceholderTokens, Converter={StaticResource BooleanToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock FontSize="11" Foreground="{StaticResource PanelDangerBrush}" TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Jeton invalide « {0} » (élément '{1}') — écrire \# pour un # littéral.">
                                <Binding Path="Raw"/>
                                <Binding Path="ElementId"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DataGrid x:Name="PlaceholderRowsDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource PanelBorderBrush}"
                  BorderThickness="1"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  ItemsSource="{Binding PlaceholderRows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#N" Binding="{Binding NumberLabel}" Width="0.6*"/>
                <DataGridTextColumn Header="Usages" Binding="{Binding UsageCount}" Width="0.6*"/>
                <DataGridTextColumn Header="Emplacements" Binding="{Binding LocationsLabel}" Width="2.4*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
