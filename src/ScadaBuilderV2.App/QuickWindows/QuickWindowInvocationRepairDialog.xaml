<Window x:Class="ScadaBuilderV2.App.QuickWindows.QuickWindowInvocationRepairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:qw="clr-namespace:ScadaBuilderV2.App.QuickWindows"
        Title="Réparer les invocations"
        Width="900"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#0F2A30"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5E7A82"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DCE8DD"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2090A0"/>
            <Setter Property="BorderBrush" Value="#0F7280"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="DefinitionLabelText"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="OutdatedSummaryText"
                       Margin="0,4,0,0"
                       FontWeight="Bold"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="Chaque invocation est reliée port par port. Aucune réparation automatique ni en masse n'est appliquée, et build comme export restent bloqués tant qu'une invocation reste à réparer."
                       Margin="0,4,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="NavigateToCallerButton"
                    Content="Voir l'appelant"
                    Click="OnNavigateToCallerClick"/>
            <Button x:Name="RepairInvocationButton"
                    Content="Réparer cette invocation"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnRepairClick"/>
            <Button x:Name="CloseRepairButton"
                    Content="Fermer"
                    IsCancel="True"
                    Click="OnCloseClick"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="OutdatedInvocationsDataGrid"
                      Grid.Column="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderBrush="{StaticResource BorderBrushSoft}"
                      BorderThickness="1"
                      SelectionChanged="OnSelectedInvocationChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Page" Binding="{Binding PageLabel}" Width="1*"/>
                    <DataGridTextColumn Header="Élément appelant" Binding="{Binding OwnerElementId}" Width="1*"/>
                    <DataGridTextColumn Header="Commande" Binding="{Binding OwnerCommandId}" Width="0.8*"/>
                    <DataGridTextColumn Header="Interface" Binding="{Binding VersionLabel}" Width="0.8*"/>
                    <DataGridTextColumn Header="Motif" Binding="{Binding ReasonLabel}" Width="2*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <qw:QuickWindowBindingsEditor x:Name="RepairBindingsEditor" Grid.Column="2"/>
        </Grid>
    </DockPanel>
</Window>
