<Window x:Class="ScadaBuilderV2.App.QuickWindows.ParameterSheetEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Feuille de paramètres"
        Width="640"
        Height="560"
        MinWidth="480"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#0F2A30"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5B7076"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DCE8DD"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2090A0"/>
            <Setter Property="BorderBrush" Value="#0F7280"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick"/>
            <Button Content="Annuler" Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}"/>
                <TextBlock Text="Une ligne par paramètre : #N := tag, littéral ou expression."
                           FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <Button Grid.Column="1" Width="30" Height="28" Padding="3"
                    Content="+" FontWeight="Bold"
                    ToolTip="Ajouter une règle"
                    Click="OnAddRuleClick"/>
        </Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="TextEditor"
                     Grid.Row="0"
                     FontFamily="Consolas"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextChanged="OnTextChanged"/>
            <TextBlock Grid.Row="1" Text="Diagnostics" FontWeight="SemiBold" Margin="0,8,0,4"
                       Foreground="{StaticResource InkBrush}"/>
            <ItemsControl x:Name="DiagnosticsList" Grid.Row="2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</Window>
