<Window x:Class="ScadaBuilderV2.App.QuickWindows.QuickWindowConfigurationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration de la fenêtre rapide" Width="440" Height="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#0F2A30"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5E7A82"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F7FBF5"/>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2090A0"/>
            <Setter Property="BorderBrush" Value="#0F7280"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource PanelBrush}" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Feuille de paramètres" Foreground="{StaticResource MutedBrush}"/>
            <ComboBox x:Name="ParameterSheetComboBox" Margin="0,2,0,12" DisplayMemberPath="DisplayName"
                      SelectionChanged="OnSelectionChanged"/>

            <TextBlock Text="Page Fenêtre rapide" Foreground="{StaticResource MutedBrush}"/>
            <ComboBox x:Name="QuickWindowPageComboBox" Margin="0,2,0,12" DisplayMemberPath="Title"
                      SelectionChanged="OnSelectionChanged"/>

            <TextBlock x:Name="ValidationText" TextWrapping="Wrap" Foreground="Firebrick"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="Enregistrer" Style="{StaticResource PrimaryButtonStyle}" Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
