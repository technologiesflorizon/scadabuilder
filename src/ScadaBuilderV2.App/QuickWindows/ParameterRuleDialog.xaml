<Window x:Class="ScadaBuilderV2.App.QuickWindows.ParameterRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouvelle règle"
        Width="420"
        Height="360"
        MinWidth="380"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#0F2A30"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5B7076"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DCE8DD"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2090A0"/>
            <Setter Property="BorderBrush" Value="#0F7280"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Ajouter" Style="{StaticResource PrimaryButtonStyle}" Click="OnAddClick" IsDefault="True"/>
            <Button Content="Annuler" Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Numéro (#N)"/>
            <TextBox x:Name="NumberTextBox" MinHeight="30"/>

            <TextBlock Text="Nature"/>
            <ComboBox x:Name="KindComboBox"
                      MinHeight="30"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectionChanged="OnKindChanged"/>

            <TextBlock Text="Tag du catalogue"/>
            <ComboBox x:Name="TagComboBox"
                      MinHeight="30"
                      DisplayMemberPath="AuthoringLabel"/>

            <TextBlock Text="Valeur"/>
            <TextBox x:Name="ValueTextBox" MinHeight="30" AcceptsReturn="False"/>

            <TextBlock x:Name="ErrorText"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource DangerBrush}"/>
        </StackPanel>
    </DockPanel>
</Window>
