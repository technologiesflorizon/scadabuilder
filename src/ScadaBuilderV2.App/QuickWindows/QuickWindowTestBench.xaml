<UserControl x:Class="ScadaBuilderV2.App.QuickWindows.QuickWindowTestBench"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BenchMutedBrush" Color="#5E7A82"/>
        <SolidColorBrush x:Key="BenchBorderBrush" Color="#DCE8DD"/>
        <SolidColorBrush x:Key="BenchInkBrush" Color="#0F2A30"/>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Banc d'essai" FontWeight="SemiBold" Foreground="{StaticResource BenchInkBrush}"/>
            <TextBlock x:Name="DefinitionLabelText"
                       Text="{Binding DefinitionLabel}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BenchMutedBrush}"/>
            <TextBlock Text="Valeurs temporaires editor-only : jamais persistées, jamais exportées."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource BenchMutedBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Titre temporaire de l'instance" Foreground="{StaticResource BenchMutedBrush}"/>
            <TextBox x:Name="TitleOverrideTextBox"
                     MinHeight="28"
                     Text="{Binding TitleOverride, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <DataGrid x:Name="TestValuesDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource BenchBorderBrush}"
                  BorderThickness="1"
                  ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Port" Binding="{Binding Name}" IsReadOnly="True" Width="1.2*"/>
                <DataGridTextColumn Header="Famille" Binding="{Binding FamilyLabel}" IsReadOnly="True" Width="1*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding DataTypeLabel}" IsReadOnly="True" Width="0.8*"/>
                <DataGridTextColumn Header="Tag temporaire" Binding="{Binding TemporaryTagId, UpdateSourceTrigger=LostFocus}" Width="1.3*"/>
                <DataGridTextColumn Header="Valeur temporaire" Binding="{Binding TemporaryValue, UpdateSourceTrigger=LostFocus}" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="OpenPreviewButton"
                    Content="Ouvrir l'aperçu"
                    MinHeight="30"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    IsEnabled="{Binding HasDefinition}"
                    Click="OnOpenPreviewClick"/>
            <Button x:Name="ClosePreviewButton"
                    Content="Fermer l'aperçu"
                    MinHeight="30"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    Click="OnClosePreviewClick"/>
            <TextBlock x:Name="BenchStatusText"
                       Text="{Binding Status}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BenchMutedBrush}"/>
        </StackPanel>

        <Border Grid.Row="4"
                BorderBrush="{StaticResource BenchBorderBrush}"
                BorderThickness="1">
            <Grid>
                <TextBlock x:Name="PreviewPlaceholderText"
                           Text="Aucune instance de prévisualisation ouverte."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BenchMutedBrush}"/>
                <wv2:WebView2 x:Name="PreviewInstanceWebView" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
