<UserControl x:Class="ScadaBuilderV2.App.QuickWindows.QuickWindowTestBench"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BenchMutedBrush" Color="#5E7A82"/>
        <SolidColorBrush x:Key="BenchBorderBrush" Color="#DCE8DD"/>
        <SolidColorBrush x:Key="BenchInkBrush" Color="#0F2A30"/>
        <SolidColorBrush x:Key="BenchDangerBrush" Color="#B3261E"/>
        <BooleanToVisibilityConverter x:Key="BenchBooleanToVisibility"/>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Banc d'essai" FontWeight="SemiBold" Foreground="{StaticResource BenchInkBrush}"/>
            <TextBlock x:Name="PageLabelText"
                       Text="{Binding PageLabel}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BenchMutedBrush}"/>
            <TextBlock Text="Prévisualise la page active avec les valeurs d'une feuille de paramètres, via la substitution réelle de montage."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Foreground="{StaticResource BenchMutedBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Feuille de paramètres" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BenchMutedBrush}"/>
            <ComboBox x:Name="SheetSelectorComboBox"
                      MinHeight="30"
                      Width="220"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding Sheets}"
                      SelectionChanged="OnSheetSelectionChanged"/>
            <Button x:Name="ClosePreviewButton"
                    Content="Fermer l'aperçu"
                    MinHeight="30"
                    Padding="12,4"
                    Margin="12,0,0,0"
                    Click="OnClosePreviewClick"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock x:Name="BenchStatusText"
                       Text="{Binding Status}"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BenchMutedBrush}"/>
            <ItemsControl ItemsSource="{Binding LoweringDiagnostics}"
                          Visibility="{Binding HasLoweringDiagnostics, Converter={StaticResource BenchBooleanToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Text="{Binding Message}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource BenchMutedBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                            <Setter Property="Foreground" Value="{StaticResource BenchDangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Border Grid.Row="3"
                BorderBrush="{StaticResource BenchBorderBrush}"
                BorderThickness="1">
            <Grid>
                <TextBlock x:Name="PreviewPlaceholderText"
                           Text="Aucune instance de prévisualisation ouverte."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BenchMutedBrush}"/>
                <wv2:WebView2 x:Name="PreviewInstanceWebView" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
