<Window x:Class="ScadaBuilderV2.App.QuickWindows.QuickWindowPasteDiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Collage refusé"
        Width="720"
        Height="460"
        MinWidth="620"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#0F2A30"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#5E7A82"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#DCE8DD"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#B3261E"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2090A0"/>
            <Setter Property="BorderBrush" Value="#0F7280"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock x:Name="HeadlineText"
                       Text="Ce collage franchit la frontière page ↔ fenêtre rapide."
                       FontWeight="SemiBold"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="SummaryText"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="Aucun collage partiel silencieux n'est proposé : annulez, ou collez sans liaisons. Les propriétés concernées resteront Non lié et ne seront jamais promues en membres d'Interface locale."
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="PasteWithoutBindingsButton"
                    Content="Coller sans liaisons"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnPasteWithoutBindingsClick"/>
            <Button x:Name="CancelPasteButton"
                    Content="Annuler"
                    IsCancel="True"
                    IsDefault="True"
                    Click="OnCancelClick"/>
        </StackPanel>

        <DataGrid x:Name="IssuesDataGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource BorderBrushSoft}"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Objet" Binding="{Binding ElementName}" Width="1.1*"/>
                <DataGridTextColumn Header="Propriété" Binding="{Binding PropertyPath}" Width="1.8*"/>
                <DataGridTextColumn Header="Référence" Binding="{Binding Reference}" Width="1.1*"/>
                <DataGridTextColumn Header="Motif" Binding="{Binding Message}" Width="2.4*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
