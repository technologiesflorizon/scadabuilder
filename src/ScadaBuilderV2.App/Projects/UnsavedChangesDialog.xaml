<Window x:Class="ScadaBuilderV2.App.Projects.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifications non enregistrées"
        SizeToContent="WidthAndHeight"
        MinWidth="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource PanelBrush}">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#0F2A30"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#4E6A71"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F4F8F6"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#1A0F2A30"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#6A4300"/>
    </Window.Resources>
    <StackPanel Margin="0">
        <StackPanel Margin="28,26,28,20">
            <TextBlock x:Name="HeadlineText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock x:Name="DetailText"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>

        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,1,0,0"
                Padding="20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- The verbs say what happens. "Oui / Non" made the destructive answer the short one. -->
                <Button x:Name="SaveButton"
                        Content="Enregistrer"
                        MinWidth="130"
                        MinHeight="34"
                        Margin="6,0"
                        IsDefault="True"
                        Click="OnSaveClick"/>
                <Button x:Name="DiscardButton"
                        Content="Ne pas enregistrer"
                        MinWidth="150"
                        MinHeight="34"
                        Margin="6,0"
                        Foreground="{StaticResource WarningBrush}"
                        Click="OnDiscardClick"/>
                <Button x:Name="CancelButton"
                        Content="Annuler"
                        MinWidth="110"
                        MinHeight="34"
                        Margin="6,0"
                        IsCancel="True"
                        Click="OnCancelClick"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
