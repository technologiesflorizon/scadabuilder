<Window x:Class="ScadaBuilderV2.App.Projects.CreateProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau projet"
        Width="620"
        Height="610"
        MinWidth="560"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Créer un projet SCADA Builder V2" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Le projet sera autonome et créé dans le dossier choisi."
                       Margin="0,6,0,0" Foreground="#596B70"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Nom du projet" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox x:Name="ProjectNameTextBox" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="4" MinHeight="30" TextChanged="OnInputChanged"/>

            <TextBlock Grid.Row="1" Text="Nom du dossier" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox x:Name="ProjectDirectoryNameTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="4" MinHeight="30" TextChanged="OnInputChanged"/>

            <TextBlock Grid.Row="2" Text="Dossier parent" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox x:Name="ParentDirectoryTextBox" Grid.Row="2" Grid.Column="1"
                     Margin="4" MinHeight="30" TextChanged="OnInputChanged"/>
            <Button Grid.Row="2" Grid.Column="2" Content="Parcourir..." MinWidth="92" Margin="4" Click="OnBrowseClick"/>

            <TextBlock Grid.Row="3" Text="Chemin final" VerticalAlignment="Top" Margin="0,9,0,6"/>
            <TextBlock x:Name="FinalPathTextBlock" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                       Margin="6,9,4,8" TextWrapping="Wrap" Foreground="#596B70"/>

            <TextBlock Grid.Row="4" Text="Code première page" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox x:Name="PageCodeTextBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="4" MinHeight="30" TextChanged="OnInputChanged"/>

            <TextBlock Grid.Row="5" Text="Titre première page" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox x:Name="PageTitleTextBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="4" MinHeight="30" TextChanged="OnInputChanged"/>

            <TextBlock Grid.Row="6" Text="Largeur" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox x:Name="WidthTextBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="4" MinHeight="30" TextChanged="OnInputChanged"/>

            <TextBlock Grid.Row="7" Text="Hauteur" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox x:Name="HeightTextBox" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="4" MinHeight="30" TextChanged="OnInputChanged"/>

            <TextBlock Grid.Row="8" Text="Mode responsive" VerticalAlignment="Center" Margin="0,6"/>
            <ComboBox x:Name="ResponsiveModeComboBox" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                      Margin="4" MinHeight="30" SelectionChanged="OnInputChanged"/>
        </Grid>

        <Border Grid.Row="2" Background="#FFF4E5" BorderBrush="#E4B252" BorderThickness="1"
                CornerRadius="4" Padding="10" Margin="0,12,0,8">
            <TextBlock x:Name="ValidationTextBlock" TextWrapping="Wrap" Foreground="#6A4300"/>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Annuler" MinWidth="100" Margin="4" IsCancel="True"/>
            <Button x:Name="CreateButton" Content="Créer" MinWidth="110" Margin="4"
                    IsDefault="True" Click="OnCreateClick"/>
        </StackPanel>
    </Grid>
</Window>
